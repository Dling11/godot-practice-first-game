[gd_resource type="Resource" script_class="LootTableDefinition" load_steps=10 format=3]

[ext_resource type="Script" path="res://data/loot/loot_table_definition.gd" id="1_table"]
[ext_resource type="Script" path="res://data/items/materials/material_stack_definition.gd" id="2_stack"]
[ext_resource type="Script" path="res://data/loot/material_drop_entry_definition.gd" id="3_drop"]
[ext_resource type="Resource" path="res://data/items/materials/forest/barbed_seed.tres" id="4_seed"]
[ext_resource type="Resource" path="res://data/items/materials/forest/weathered_fittings.tres" id="5_fittings"]
[ext_resource type="Resource" path="res://data/items/materials/forest/thorn_sap.tres" id="6_sap"]

[sub_resource type="Resource" id="First_seed"]
script = ExtResource("2_stack")
material = ExtResource("4_seed")
quantity = 3

[sub_resource type="Resource" id="First_fittings"]
script = ExtResource("2_stack")
material = ExtResource("5_fittings")
quantity = 2

[sub_resource type="Resource" id="Replay_seed"]
script = ExtResource("2_stack")
material = ExtResource("4_seed")
quantity = 2

[sub_resource type="Resource" id="Replay_fittings"]
script = ExtResource("2_stack")
material = ExtResource("5_fittings")
quantity = 1

[sub_resource type="Resource" id="Optional_sap"]
script = ExtResource("3_drop")
material = ExtResource("6_sap")
minimum_quantity = 1
maximum_quantity = 1
chance = 0.4
bad_luck_protection_key = &"forest_stage_2_thorn_sap_misses"
guaranteed_after_misses = 3

[resource]
script = ExtResource("1_table")
loot_table_id = &"forest_stage_2_clear"
stage_id = &"thorns_of_the_forgotten_grove"
region_id = &"forest"
first_clear_claim_id = &"forest_stage_2_first_clear_claim"
first_clear_guarantees = Array[Resource]([SubResource("First_seed"), SubResource("First_fittings")])
replay_guarantees = Array[Resource]([SubResource("Replay_seed"), SubResource("Replay_fittings")])
optional_rewards = Array[Resource]([SubResource("Optional_sap")])
first_clear_recipe_ids = PackedStringArray("forest_thornward_clasp")
