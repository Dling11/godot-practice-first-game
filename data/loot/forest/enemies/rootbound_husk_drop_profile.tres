[gd_resource type="Resource" script_class="DropProfileDefinition" load_steps=6 format=3]

[ext_resource type="Script" path="res://data/loot/drop_profile_definition.gd" id="1_profile"]
[ext_resource type="Script" path="res://data/loot/material_drop_entry_definition.gd" id="2_entry"]
[ext_resource type="Resource" path="res://data/items/materials/forest/husk_heartwood.tres" id="3_heartwood"]
[ext_resource type="Resource" path="res://data/items/materials/forest/rootbound_core.tres" id="4_core"]

[sub_resource type="Resource" id="Drop_heartwood"]
script = ExtResource("2_entry")
material = ExtResource("3_heartwood")
minimum_quantity = 2
maximum_quantity = 3
chance = 1.0

[sub_resource type="Resource" id="Drop_core"]
script = ExtResource("2_entry")
material = ExtResource("4_core")
minimum_quantity = 1
maximum_quantity = 1
chance = 1.0

[resource]
script = ExtResource("1_profile")
profile_id = &"forest_rootbound_husk_drops"
source_enemy_id = &"rootbound_husk"
