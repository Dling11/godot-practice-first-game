[gd_resource type="Resource" script_class="DropProfileDefinition" load_steps=6 format=3]

[ext_resource type="Script" path="res://data/loot/drop_profile_definition.gd" id="1_profile"]
[ext_resource type="Script" path="res://data/loot/material_drop_entry_definition.gd" id="2_entry"]
[ext_resource type="Resource" path="res://data/items/materials/forest/forsaken_cloth.tres" id="3_cloth"]
[ext_resource type="Resource" path="res://data/items/materials/forest/weathered_fittings.tres" id="4_fittings"]

[sub_resource type="Resource" id="Drop_cloth"]
script = ExtResource("2_entry")
material = ExtResource("3_cloth")
minimum_quantity = 1
maximum_quantity = 1
chance = 1.0

[sub_resource type="Resource" id="Drop_fittings"]
script = ExtResource("2_entry")
material = ExtResource("4_fittings")
minimum_quantity = 1
maximum_quantity = 1
chance = 0.3
bad_luck_protection_key = &"forest_weathered_fittings_misses"
guaranteed_after_misses = 4

[resource]
script = ExtResource("1_profile")
profile_id = &"forest_forsaken_thrall_drops"
source_enemy_id = &"forsaken_thrall"
region_id = &"forest"
guaranteed_common = Array[Resource]([SubResource("Drop_cloth")])
optional_secondary = Array[Resource]([SubResource("Drop_fittings")])
