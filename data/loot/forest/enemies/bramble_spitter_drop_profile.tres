[gd_resource type="Resource" script_class="DropProfileDefinition" load_steps=6 format=3]

[ext_resource type="Script" path="res://data/loot/drop_profile_definition.gd" id="1_profile"]
[ext_resource type="Script" path="res://data/loot/material_drop_entry_definition.gd" id="2_entry"]
[ext_resource type="Resource" path="res://data/items/materials/forest/barbed_seed.tres" id="3_seed"]
[ext_resource type="Resource" path="res://data/items/materials/forest/thorn_sap.tres" id="4_sap"]

[sub_resource type="Resource" id="Drop_seed"]
script = ExtResource("2_entry")
material = ExtResource("3_seed")
minimum_quantity = 1
maximum_quantity = 1
chance = 1.0

[sub_resource type="Resource" id="Drop_sap"]
script = ExtResource("2_entry")
material = ExtResource("4_sap")
minimum_quantity = 1
maximum_quantity = 1
chance = 0.35
bad_luck_protection_key = &"forest_thorn_sap_misses"
guaranteed_after_misses = 3

[resource]
script = ExtResource("1_profile")
profile_id = &"forest_bramble_spitter_drops"
source_enemy_id = &"bramble_spitter"
region_id = &"forest"
guaranteed_common = Array[Resource]([SubResource("Drop_seed")])
optional_secondary = Array[Resource]([SubResource("Drop_sap")])
