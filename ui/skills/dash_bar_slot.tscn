[gd_scene load_steps=4 format=3]

[ext_resource type="Script" path="res://ui/skills/dash_bar_slot.gd" id="1_script"]
[ext_resource type="Texture2D" path="res://assets/ui/icons/actions/icon_action_dash_24x24.png" id="2_icon"]

[sub_resource type="StyleBoxFlat" id="cooldown_fill"]
bg_color = Color(0.42, 0.72, 0.86, 0.9)

[node name="DashBarSlot" type="PanelContainer"]
custom_minimum_size = Vector2(72, 58)
layout_mode = 2
mouse_filter = 2
script = ExtResource("1_script")

[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 2
mouse_filter = 2
theme_override_constants/margin_left = 5
theme_override_constants/margin_top = 3
theme_override_constants/margin_right = 5
theme_override_constants/margin_bottom = 3

[node name="Content" type="HBoxContainer" parent="Margin"]
layout_mode = 2
mouse_filter = 2
theme_override_constants/separation = 3

[node name="Icon" type="TextureRect" parent="Margin/Content"]
custom_minimum_size = Vector2(24, 24)
layout_mode = 2
mouse_filter = 2
texture = ExtResource("2_icon")
expand_mode = 1
stretch_mode = 5

[node name="Stack" type="VBoxContainer" parent="Margin/Content"]
layout_mode = 2
mouse_filter = 2
size_flags_horizontal = 3
theme_override_constants/separation = 1

[node name="Header" type="HBoxContainer" parent="Margin/Content/Stack"]
layout_mode = 2
mouse_filter = 2

[node name="KeyLabel" type="Label" parent="Margin/Content/Stack/Header"]
layout_mode = 2
mouse_filter = 2
text = "SPC"
theme_override_colors/font_color = Color(0.7, 0.86, 1, 1)
theme_override_font_sizes/font_size = 9

[node name="Spacer" type="Control" parent="Margin/Content/Stack/Header"]
layout_mode = 2
mouse_filter = 2
size_flags_horizontal = 3

[node name="StateLabel" type="Label" parent="Margin/Content/Stack/Header"]
unique_name_in_owner = true
layout_mode = 2
mouse_filter = 2
text = "READY"
theme_override_colors/font_color = Color(0.62, 0.9, 0.54, 1)
theme_override_font_sizes/font_size = 8

[node name="ActionName" type="Label" parent="Margin/Content/Stack"]
layout_mode = 2
mouse_filter = 2
text = "DASH"
theme_override_colors/font_color = Color(0.78, 0.8, 0.72, 1)
theme_override_font_sizes/font_size = 8

[node name="CooldownBar" type="ProgressBar" parent="Margin/Content/Stack"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 4)
layout_mode = 2
mouse_filter = 2
show_percentage = false
theme_override_styles/fill = SubResource("cooldown_fill")

[node name="CooldownTick" type="Timer" parent="."]
unique_name_in_owner = true
wait_time = 0.1

[node name="ActivationButton" type="Button" parent="."]
unique_name_in_owner = true
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 0
focus_mode = 0
mouse_default_cursor_shape = 2
tooltip_text = "Dash (Space)"
flat = true

[connection signal="timeout" from="CooldownTick" to="." method="_on_cooldown_tick"]
[connection signal="pressed" from="ActivationButton" to="." method="_on_activation_button_pressed"]
